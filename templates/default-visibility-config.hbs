<div class="default-visibility-config">
    <div class="form-header">
        <p class="notes">{{localize "INSPECTSTATBLOCK.DefaultsConfig.Intro"}} <strong>{{systemId}}</strong></p>
    </div>

    {{#if groups.length}}
        <div class="button-group">
            <button type="button" data-action="toggleAllOn" class="toggle-button show-all">
                <i class="fa-solid fa-eye" inert></i> {{localize "INSPECTSTATBLOCK.DefaultsConfig.ShowAll"}} ({{totalSettings}})
            </button>
            <button type="button" data-action="toggleAllOff" class="toggle-button hide-all">
                <i class="fa-solid fa-eye-slash" inert></i> {{localize "INSPECTSTATBLOCK.DefaultsConfig.HideAll"}}
            </button>
        </div>

        {{#each groups}}
            <div class="container-section">
                <h3><i class="fa-solid {{icon}}" inert></i> {{localize label}}</h3>
                <p class="notes">{{localize hint}}</p>
                <div class="container-chips">
                    {{#each settings}}
                        <button type="button" class="chip {{#if enabled}}active{{/if}}" data-action="toggleChip"
                                aria-pressed="{{enabled}}" data-value="{{key}}">
                            {{localize label}}
                            <input type="hidden" name="setting-{{key}}" value="{{enabled}}">
                        </button>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    {{else}}
        <div class="container-section">
            <p class="no-settings">
                <i class="fa-solid fa-triangle-exclamation" inert></i>
                {{localize "INSPECTSTATBLOCK.DefaultsConfig.NoSettings"}} "{{systemId}}"
            </p>
        </div>
    {{/if}}

    <footer class="sheet-footer flexrow">
        <button type="submit" class="dialog-button">
            <i class="fa-solid fa-floppy-disk" inert></i> {{localize "INSPECTSTATBLOCK.DefaultsConfig.Save"}}
        </button>
        <button type="button" class="dialog-button" data-action="close">
            <i class="fa-solid fa-xmark" inert></i> {{localize "INSPECTSTATBLOCK.DefaultsConfig.Cancel"}}
        </button>
    </footer>
</div>
